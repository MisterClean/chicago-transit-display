# Copy to server/.env when running from the repository root.
# These secrets stay on the backend. Do not put them in VITE_* variables.
CTA_BUS_API_KEY=
CTA_TRAIN_API_KEY=
GEOCODIO_API_KEY=

# Optional GBFS adapter. Confirm live-feed/public-display rights and written
# permission for Divvy name/marks before public launch; availability is not permission.
# See docs/mobility-compliance-review.md. This flag does not record approval.
DIVVY_ENABLED=false

BIND_ADDR=127.0.0.1:3001
# Optional built frontend (relative to process working directory):
# STATIC_DIR=dist

# Optional writable schedule cache path. Default: server/data/runtime/schedules.json
# Automatically downloaded at startup and daily; generated data stays outside Git.
# SCHEDULE_PATH=server/data/runtime/schedules.json
