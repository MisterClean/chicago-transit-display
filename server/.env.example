# Copy to server/.env when running from the repository root.
# These secrets stay on the backend. Do not put them in VITE_* variables.
CTA_BUS_API_KEY=
CTA_TRAIN_API_KEY=
GEOCODIO_API_KEY=

# Optional public GBFS adapter. Review the applicable Divvy/Lyft feed and
# public-display terms before enabling it in a production installation.
DIVVY_ENABLED=false

BIND_ADDR=127.0.0.1:3001
# Optional built frontend (relative to process working directory):
# STATIC_DIR=dist
