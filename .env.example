# Public browser key: restrict its allowed origins in the Protomaps dashboard.
VITE_PROTOMAPS_API_KEY=your_protomaps_public_key
# Optional compatible MapLibre style URL instead of the hosted Protomaps API.
# VITE_MAP_STYLE_URL=https://your-host.example/style.json
# Local backend used by Vite's same-origin development proxy.
API_PROXY_TARGET=http://127.0.0.1:3001
